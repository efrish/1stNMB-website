# Runtime
PORT=8080
NODE_ENV=development
BASE_PATH=/

# Website database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Administrative access
# Use a long unique value stored only in Replit Secrets.
ADMIN_PASSWORD=

# Owner notifications
NOTIFICATION_EMAIL=
NOTIFICATION_PHONE=

# Gmail SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
GMAIL_FROM=

# Twilio connector
TWILIO_ACCOUNT_SID=
TWILIO_FROM_PHONE=

# CRM integration
CRM_BASE_URL=https://century-hollywood-crm.replit.app
CRM_WEBHOOK_SECRET=

# Borrower scheduling
OUTLOOK_BOOKING_URL=
